#!/bin/sh
# Pre-commit gate for the paper-tailwind-tokens skill.
#
# Runs the documented local suite. A failing lane blocks the commit with a
# nonzero exit -- the behaviour tests/README.md promises and the audit proved
# empirically (injecting a wrong expectation exits 1).
#
# Bypass: `git commit --no-verify`. The escape hatch is deliberate. A gate that
# cannot be bypassed under pressure gets deleted instead of respected.

set -eu

cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  printf 'pre-commit: node_modules is missing -- run `npm install` first.\n' >&2
  exit 1
fi

printf 'pre-commit: running npm test (contract + browser lanes)...\n'

if output=$(npm test 2>&1); then
  printf 'pre-commit: %s\n' "$(printf '%s\n' "$output" | grep -E '^. (pass|fail) ' | tr '\n' ' ')"
  exit 0
fi

printf '%s\n' "$output" >&2
cat >&2 <<'HINT'

pre-commit: the local suite failed. No commit was created.

  Likely causes:
    - Pinned Chromium not downloaded  ->  npx playwright install chromium
    - A real regression               ->  read the failing assertion above

  Deliberate WIP commit on a scratch branch:  git commit --no-verify
HINT
exit 1
